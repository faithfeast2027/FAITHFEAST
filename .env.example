import { PrismaClient } from '@prisma/client';
import bcrypt from 'bcryptjs';

const prisma = new PrismaClient();

async function main() {
  const passwordHash = await bcrypt.hash('Password123!', 10);

  const customer = await prisma.user.upsert({
    where: { email: 'customer@faithfeast.com' },
    update: {},
    create: {
      name: 'Customer Demo',
      email: 'customer@faithfeast.com',
      passwordHash,
      role: 'CUSTOMER',
    },
  });

  const vendor = await prisma.user.upsert({
    where: { email: 'vendor@faithfeast.com' },
    update: {},
    create: {
      name: 'Vendor Demo',
      email: 'vendor@faithfeast.com',
      passwordHash,
      role: 'VENDOR',
    },
  });

  const driver = await prisma.user.upsert({
    where: { email: 'driver@faithfeast.com' },
    update: {},
    create: {
      name: 'Driver Demo',
      email: 'driver@faithfeast.com',
      passwordHash,
      role: 'DRIVER',
    },
  });

  const driverProfile = await prisma.driverProfile.upsert({
    where: { id: 'driver-demo-profile' },
    update: {},
    create: {
      id: 'driver-demo-profile',
      userId: driver.id,
      vehicleType: 'bike',
      rating: 4.9,
      status: 'active',
    },
  });

  await prisma.dailyDrop.createMany({
    data: [
      { name: 'Fire-Roasted Chicken Bowl', vendor: 'Kite Kitchen', price: 18, quantity: 22 },
      { name: 'Crispy Tofu & Greens', vendor: 'Bloom Table', price: 16, quantity: 18 },
      { name: 'Rosemary Lamb Flatbread', vendor: 'Moss & Ember', price: 22, quantity: 12 },
    ],
    skipDuplicates: true,
  });

  await prisma.driverEarning.createMany({
    data: [
      { driverId: driverProfile.id, periodLabel: 'Monday', tipsCents: 5200, deliveryFeeCents: 4000, totalCents: 9200 },
      { driverId: driverProfile.id, periodLabel: 'Tuesday', tipsCents: 4800, deliveryFeeCents: 2800, totalCents: 7600 },
      { driverId: driverProfile.id, periodLabel: 'Wednesday', tipsCents: 8200, deliveryFeeCents: 5000, totalCents: 13200 },
    ],
    skipDuplicates: true,
  });

  console.log('Seeded demo users, drops, and driver earnings.', { customer, vendor, driver });
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
