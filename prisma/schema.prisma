generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model daily_drops {
  id                 String   @id @default(uuid())
  drop_date          DateTime
  title              String
  description        String
  price              Float
  remaining_quantity Int
  created_at         DateTime @default(now())
}
